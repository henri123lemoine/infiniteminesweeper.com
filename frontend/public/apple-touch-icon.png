<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 180 180">
  <!-- Mine icon design scaled up for Apple touch icon -->
  <rect width="180" height="180" fill="#f0f0f0" rx="20"/>
  <circle cx="90" cy="90" r="40" fill="#333"/>
  
  <!-- Spikes around the mine -->
  <rect x="85" y="10" width="10" height="30" fill="#333"/>
  <rect x="85" y="140" width="10" height="30" fill="#333"/>
  <rect x="10" y="85" width="30" height="10" fill="#333"/>
  <rect x="140" y="85" width="30" height="10" fill="#333"/>
  
  <!-- Diagonal spikes -->
  <rect x="35" y="35" width="20" height="10" fill="#333" transform="rotate(45 45 40)"/>
  <rect x="125" y="35" width="20" height="10" fill="#333" transform="rotate(-45 135 40)"/>
  <rect x="35" y="135" width="20" height="10" fill="#333" transform="rotate(-45 45 140)"/>
  <rect x="125" y="135" width="20" height="10" fill="#333" transform="rotate(45 135 140)"/>
</svg>